# Normalize line endings: store as LF in the repo and check out as LF
# everywhere, regardless of the contributor's core.autocrlf setting.
* text=auto eol=lf

# Scripts must stay LF — CRLF breaks the shebang / execution.
*.sh text eol=lf
*.py text eol=lf

# Treat common binary assets as binary (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
